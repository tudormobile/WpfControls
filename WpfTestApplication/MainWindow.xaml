<Window x:Class="WpfTestApplication.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfTestApplication" Background="AliceBlue"
        xmlns:controls="clr-namespace:Tudormobile.Wpf.Controls;assembly=Tudormobile.WpfControls"
        mc:Ignorable="d" AllowsTransparency="True" WindowStyle="None" ThemeMode="Light"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel LastChildFill="True">
        <controls:TitleBar DockPanel.Dock="Top">
            <TextBlock Text="{Binding WindowTitle}" FontWeight="SemiBold"/>
        </controls:TitleBar>
        <Grid Background="Yellow"/>
    </DockPanel>
</Window>
