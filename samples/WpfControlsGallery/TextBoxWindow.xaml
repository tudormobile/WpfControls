<Window x:Class="WpfControlsGallery.TextBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfControlsGallery"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:behaviors="clr-namespace:Tudormobile.Wpf.Behaviors;assembly=Tudormobile.WpfControls"
        mc:Ignorable="d" 
        Title="TextBoxWindow" Height="450" Width="800">
    <UniformGrid Columns="3">
        <UniformGrid.Resources>
            <Style TargetType="TextBox">
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Margin" Value="10,0"/>
                <Setter Property="Height" Value="24"/>
            </Style>
        </UniformGrid.Resources>
        <TextBlock Text="TextBox with AutoSelect=true:" Margin="10,0" VerticalAlignment="Bottom"/>
        <TextBlock Text="TextBox with Placeholder text" Margin="10,0" VerticalAlignment="Bottom"/>
        <TextBlock Text="TextBox with AutoComplete DaysOfWeek enum" Margin="10,0" VerticalAlignment="Bottom"/>
        <TextBox behaviors:TextBox.AutoSelect="True"
                 Text="This is a TextBox with AutoSelect enabled"/>
        <TextBox behaviors:TextBox.PlaceholderText="Search" />
        <TextBox behaviors:TextBox.PlaceholderText="Type a Day of the Week" 
                 behaviors:TextBox.AutoComplete="{x:Type sys:DayOfWeek}"/>
        <TextBox behaviors:TextBox.Glyph="&#xE721;" behaviors:TextBox.PlaceholderText="Search Glyph present no padding"/>
        <TextBox behaviors:TextBox.Glyph="&#xE721;" behaviors:TextBox.PlaceholderText="Search Glyph present padding=2" Padding="2,0"/>
        <TextBox behaviors:TextBox.AutoComplete="#Custom#Delimined#String#" behaviors:TextBox.PlaceholderText="AutoComplete #Custom#Delimined#String#"/>
        <TextBox behaviors:TextBox.AutoComplete="One|Two|Three|Four|Five|Six" behaviors:TextBox.PlaceholderText="One|Two|Three|Four|Five|Six"/>
        <TextBox Padding="4,0,0,0"
            behaviors:TextBox.PlaceholderText="Enter a greek letter"
            behaviors:TextBox.AutoSelect="True"
            behaviors:TextBox.Glyph="&#xE70F;"
            behaviors:TextBox.AutoComplete="{Binding}"
            />
        <TextBox>
            <behaviors:TextBox.AutoComplete>
                <x:Array Type="{x:Type sys:String}">
                    <sys:String>This is the first one</sys:String>
                    <sys:String>second</sys:String>
                    <sys:String>Third</sys:String>
                </x:Array>
            </behaviors:TextBox.AutoComplete>
        </TextBox>
    </UniformGrid>
</Window>
