<Window x:Class="WpfControlsGallery.ChartTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfControlsGallery"
        xmlns:controls="clr-namespace:Tudormobile.Wpf.Controls;assembly=Tudormobile.WpfControls"
        mc:Ignorable="d"
        Title="Chart Test Window" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:PieChart x:Name="pieChart" Series="{Binding PieChartData}"
                           Title="Simple Pie Chart"
                           Margin="0" Padding="20"
                           Grid.Row="0" Tint="DarkBlue"
                           Grid.Column="1"/>
        <controls:BarChart x:Name="barChart" Series="{Binding BarChartData}"
                           Title="Simple Bar Chart"
                           Margin="0" Padding="20"
                           Grid.Row="1"
                           Grid.Column="1"/>

        <ListBox Grid.Row="0" Grid.Column="0" ItemsSource="{Binding PieChartData.DataPoints}"/>
        <ListBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding BarChartData.DataPoints}"/>
    </Grid>
</Window>
