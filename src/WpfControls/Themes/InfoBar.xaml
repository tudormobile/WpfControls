<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:local="clr-namespace:Tudormobile.Wpf.Controls"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type local:InfoBar}">
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:InfoBar}">
                    <ControlTemplate.Resources>
                        <ResourceDictionary>
                            <ResourceDictionary.MergedDictionaries>
                                <ResourceDictionary Source="pack://application:,,,/Tudormobile.WpfControls;component/Themes/Styles.xaml" />
                            </ResourceDictionary.MergedDictionaries>
                            <BooleanToVisibilityConverter x:Key="boolToVisConverter"/>
                        </ResourceDictionary>
                    </ControlTemplate.Resources>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            x:Name="root" Visibility="Collapsed" 
                            Padding="{Binding Padding, RelativeSource={RelativeSource TemplatedParent}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="icon" FontSize="18" FontFamily="Segoe Fluent Icons" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4"/>
                                <WrapPanel Grid.RowSpan="2" Grid.Column="1" Margin="0,4">
                                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource TemplatedParent}}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0"/>
                                    <TextBlock Margin="4,0"
                                    Text="{Binding Message, RelativeSource={RelativeSource TemplatedParent}}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding Text, RelativeSource={RelativeSource self}}"
                                    />
                                </WrapPanel>
                                <Button x:Name="close" Grid.Column="2" ToolTip="Close" Padding="4" Visibility="{TemplateBinding IsClosable, Converter={StaticResource boolToVisConverter}}"
                                        Style="{StaticResource plainButtonStyle}" Background="Transparent" Opacity=".75"
                                        Content="&#xE711;" FontSize="14" FontFamily="Segoe Fluent Icons" 
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,2,2,4"/>
                            </Grid>
                        </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsOpen" Value="True">
                            <Setter TargetName="root" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="Severity" Value="Informational">
                            <Setter TargetName="icon" Property="Text" Value="&#xF167;"/>
                            <Setter TargetName="icon" Property="Foreground" Value="Blue"/>
                        </Trigger>
                        <Trigger Property="Severity" Value="Success">
                            <Setter TargetName="icon" Property="Text" Value="&#xEC61;"/>
                            <Setter TargetName="icon" Property="Foreground" Value="Green"/>
                            <Setter TargetName="root" Property="Background" Value="#1000ff00"/>
                        </Trigger>
                        <Trigger Property="Severity" Value="Warning">
                            <Setter TargetName="icon" Property="Text" Value="&#xE814;"/>
                            <Setter TargetName="icon" Property="Foreground" Value="#ff9d5d00"/>
                            <Setter TargetName="root" Property="Background" Value="#10ffff00"/> 
                        </Trigger>
                        <Trigger Property="Severity" Value="Error">
                            <Setter TargetName="icon" Property="Text" Value="&#xEB90;"/>
                            <Setter TargetName="icon" Property="Foreground" Value="Red"/>
                            <Setter TargetName="root" Property="Background" Value="#10ff0000"/>
                        </Trigger>

                        <EventTrigger SourceName="close" RoutedEvent="Button.Click">
                            <BeginStoryboard>
                                <Storyboard>
                                    <BooleanAnimationUsingKeyFrames Storyboard.TargetProperty="IsOpen">
                                        <DiscreteBooleanKeyFrame Value="False" KeyTime="0:0:0"/>
                                    </BooleanAnimationUsingKeyFrames>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>