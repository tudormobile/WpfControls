<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Tudormobile.Wpf.Controls">

    <Style TargetType="{x:Type local:Card}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ContentPresenter Grid.Row="0" ContentSource="Header"/>
                        <Border Grid.Row="1" 
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}" Panel.ZIndex="10"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <!-- Layout container is required to allow ClipToBounds behaviors to work correctly -->
                            <Grid ClipToBounds="True">
                                <AdornerDecorator Opacity="{Binding ElementName=PART_ContentPresenter, Path=Opacity}">
                                    <ContentPresenter x:Name="PART_ContentPresenter"/>
                                </AdornerDecorator>
                            </Grid>
                        </Border>
                        <ContentPresenter Grid.Row="2" ContentSource="Footer"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>