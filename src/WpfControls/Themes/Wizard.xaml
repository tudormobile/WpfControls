<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Tudormobile.Wpf.Controls">
    <Style TargetType="{x:Type local:Wizard}">
        <Setter Property="ShowInTaskbar" Value="False"/>
        <Setter Property="WindowStyle" Value="SingleBorderWindow"/>
        <Setter Property="ResizeMode" Value="NoResize"/>
        <Setter Property="Icon" Value="{x:Null}" />
        <Setter Property="Title" Value="Wizard"/>
        <Setter Property="MinWidth" Value="400"/>
        <Setter Property="MinHeight" Value="300"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Wizard}">
                    <Grid Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!--<TextBlock Text="This is a NavigationWindow" FontSize="16" FontWeight="Bold" Margin="10"/>-->
                        <ContentPresenter x:Name="PART_NavWinCP" Grid.Row="1"/>
                        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,0,14,4" >
                            <Button x:Name="PART_FinishButton" DockPanel.Dock="Right" Content="Cancel" Width="90" Margin="0,10,10,10" />
                            <Button x:Name="PART_ForwardButton" DockPanel.Dock="Right" Width="90" Margin="0,10,10,10">
                                <TextBlock x:Name="forwardButtonText">
                                        <Run Text="Next "/>
                                        <Run FontFamily="Segoe Fluent Icons" Text="&#xEA47;" BaselineAlignment="Bottom"/>
                                </TextBlock>
                            </Button>
                            <Button Command="NavigationCommands.BrowseBack" DockPanel.Dock="Right" Width="90" Margin="0,10,10,10">
                                <TextBlock x:Name="backButtonText">
                                        <Run FontFamily="Segoe Fluent Icons" Text="&#xE830;" BaselineAlignment="Bottom"/>
                                        <Run Text=" Back" />
                                </TextBlock>
                            </Button>
                        </DockPanel>
                        <ResizeGrip x:Name="PART_ResizeGrip" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2" Cursor="SizeNWSE" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding CanGoBack, RelativeSource={RelativeSource self}}" Value="False">
                            <Setter TargetName="backButtonText" Property="Opacity" Value="0.5"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsEnabled, ElementName=PART_ForwardButton}" Value="False">
                            <Setter TargetName="forwardButtonText" Property="Opacity" Value="0.5"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>