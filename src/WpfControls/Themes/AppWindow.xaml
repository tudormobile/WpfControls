<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:local="clr-namespace:Tudormobile.Wpf.Controls"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type local:AppWindow}">
        <Setter Property="Background" Value="{DynamicResource ResourceKey={x:Static SystemColors.WindowBrushKey}}"/>
        <Setter Property="ResizeMode" Value="CanResize"/>
        <Setter Property="MinHeight" Value="60"/>
        <Setter Property="MinWidth" Value="124"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:AppWindow}">
                    <Border x:Name="windowBorder" SnapsToDevicePixels="True"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            CornerRadius="10"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Top Row for titleBar -->
                            <local:TitleBar x:Name="titleBar" Grid.Row="0" />
                            <!-- Middle Row for content -->
                            <Border SnapsToDevicePixels="True" Grid.Row="1" Background="{Binding ContentBackground, RelativeSource={RelativeSource TemplatedParent}}">
                                <ContentPresenter />
                            </Border>
                            <!-- Bottom Row for bottom content -->
                            <ContentControl SnapsToDevicePixels="True" x:Name="bottomContent" Grid.Row="2" Content="{Binding StatusAreaContent, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <!-- Resize grip on top of everything -->
                            <ResizeGrip x:Name="resizeGrip" Grid.RowSpan="3" 
                                        IsHitTestVisible="True" SnapsToDevicePixels="True"
                                        Margin="0,0,3,3"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Cursor="SizeNWSE" 
                                         />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>